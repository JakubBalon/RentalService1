@model RentalService.Models.Login
<head>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/index.global.js"></script>

    <link rel="stylesheet" href="~/RentalService.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="span 12">


@using (Html.BeginForm("Login", "Account", FormMethod.Post))
{
    @Html.ValidationSummary();

   
    

 

                <section class="h-100 gradient-form" style="background-color: #1b6ec2; border-radius: 5px">
  <div class="container py-5 h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col-xl-10">
        <div class="card rounded-3 text-black">
          <div class="row g-0">
            
              <div class="card-body p-md-5 mx-md-4">

                <div class="text-center">
                    <img src="https://cdn.pixabay.com/photo/2013/07/12/15/51/baseball-150428_1280.png"
                    style="width: 185px;" alt="logo">
                  <h4 class="mt-1 mb-5 pb-1">Welcome to Sport Rental App</h4>
                </div>

                <form>
                  <p>Please login to your account</p>

                  <div data-mdb-input-init class="form-outline mb-4">
                    <input asp-for="@Model.UserName" type="login" id="form2Example11" class="form-control"
                      placeholder="Type your login here" />
                    <label  asp-for="@Model.UserName"class="form-label" for="form2Example11">Username</label>
                  </div>

                  <div data-mdb-input-init class="form-outline mb-4">
                    <input asp-for="@Model.Password" type="password" id="form2Example22" class="form-control"
                    placeholder="Type your password here" />
                    <label asp-for="@Model.Password" class="form-label" for="form2Example22">Password</label>
                  </div>

                  <div class="text-center pt-1 mb-5 pb-1">
                    <button data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-block fa-lg gradient-custom-2 mb-3" type="submit">Log
                      in</button>
                    
                  </div>

                 

                </form>
              
              </div>
            </div>
            
          </div>
        
      </div>
    </div>
  </div>
</section>
  
</form>

}
</div>

</body>